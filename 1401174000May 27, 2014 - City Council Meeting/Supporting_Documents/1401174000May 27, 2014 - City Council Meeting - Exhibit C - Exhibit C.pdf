                        <script language="javascript">
            function resizeSlide() {
                var ratio = (document.documentElement.offsetWidth * .95) / slide.width;
                var height = slide.height * ratio;
                var width = document.documentElement.offsetWidth * .95;
                slide.height = height;
                slide.width = width;
                window.status = height + " x " + width + "(" + ratio + ")";
            }
            window.onload = function() { resizeSlide() }
            window.onresize = function() { resizeSlide() }
            </script>
